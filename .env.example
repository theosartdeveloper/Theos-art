# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Email Service (Resend) — required for transactional + admin emails
# Create an API key at https://resend.com and verify your sending domain.
RESEND_API_KEY=your_resend_api_key_here
# Prefer a verified domain address, e.g. Theos Art <info@theosartltd.com>
EMAIL_FROM=Theos Art <info@theosartltd.com>
# Also used if set. New shop-order alerts go to Site & branding Email first.
ADMIN_NOTIFICATION_EMAIL=info@theosartltd.com
LEADERSHIP_REPORT_EMAILS=info@theosartltd.com

# Application
NEXT_PUBLIC_APP_NAME=Theos Art
NEXT_PUBLIC_APP_URL=https://www.theosart.com

# Cloudflare R2 — preferred media storage (products, gallery, courses, receipts, hero)
# Full steps: scripts/43-r2-setup.md
# Create Account API token with Object Read & Write on your bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=platform-media
# Public base (no trailing slash): custom domain OR https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=
# Same URL for client-side hero video URLs (required on Vercel)
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=
# Optional: serve hero stills from R2 /hero (after you upload them)
# NEXT_PUBLIC_HERO_USE_R2=true
# NEXT_PUBLIC_HERO_VIDEOS_BASE_URL=https://media.theosart.com/hero
# After creating the bucket, set CORS — see scripts/43-r2-cors.json

# Set to true to expose extra auth diagnostics (login always shows debug on failure)
AUTH_DEBUG=false
